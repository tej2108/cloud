# Login for the password-protected preview (see src/proxy.ts).
# Copy to .env.local for local testing, and set the same names in your host's
# environment variable settings. Never commit real values.
SITE_USERNAME=
SITE_PASSWORD=

# Saved watchlist and comparisons (optional; without either, saving is switched off)
# Hosted Postgres connection string, used in production
DATABASE_URL=
# Set to 1 to use a local embedded database for development and testing
USE_LOCAL_DB=
